{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "@/*": ["../src/*"],
      "@convex/*": ["../convex/*"]
    }
  },
  // `../convex` is in scope because this project is the one that runs its tests
  // (§15.1's `convex` runner lives in `vitest.config.ts` here) and the one that
  // imports its generated `api`. The root project excludes it.
  "include": ["src", "test", "../convex", "vite.config.ts", "vitest.config.ts"]
}
