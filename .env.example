# The real file is `.env.local`, which is gitignored. This one names the vars and
# nothing else.
#
# `npx convex dev` writes the two client vars `EXPO_PUBLIC_`-prefixed, because it
# detects Expo at the repo root. The web app reads the `VITE_` prefix (SPEC §2) —
# Vite exposes no other one to the bundle — so a local checkout renames them.

# Read by the Convex CLI, not the client. Keeps its name.
CONVEX_DEPLOYMENT=

VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
